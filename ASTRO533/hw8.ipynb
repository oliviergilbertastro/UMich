   "source": [
    "import astropy.units as u\n",
    "import astropy.constants as cst\n",
    "import numpy as np\n",
    "\n",
    "print(cst.G)\n",
    "print((cst.G).to(u.pc * u.M_sun**-1 * u.km**2 * u.s**-2))\n",
    "print(4*np.pi/(cst.G).to(u.AU * u.M_sun**-1 * u.AU**2 * u.yr**-2))"
   ]
  }
