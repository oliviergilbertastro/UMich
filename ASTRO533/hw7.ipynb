   "source": [
    "import astropy.units as u\n",
    "import astropy.constants as cst\n",
    "import numpy as np\n",
    "\n",
    "M_pc = 0.12*u.M_sun\n",
    "K = (M_pc*0.05*cst.c**2).to(u.erg)\n",
    "print(K)\n",
    "\n",
    "u_ej = cst.c*np.sqrt(1-(1/(1+K/(0.95*M_pc*cst.c**2)))**2)\n",
    "u_ej = u_ej.to(u.km/u.s)\n",
    "print(u_ej/(cst.c.to(u.km/u.s)))\n",
    "print(u_ej)"
   ]
  }
 ],
